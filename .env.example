# Local, single learner MVP. Leave DATABASE_URL empty for persistent demo JSON storage.
PORT=3001
DATABASE_URL=
# Example: postgresql://vibelab:vibelab_local@127.0.0.1:5432/vibelab
GITHUB_TOKEN=
# Optional. Set BOTH values to enable AI. Never add secrets to VITE_ variables.
OPENAI_API_KEY=
OPENAI_MODEL=
DATA_FILE=.data/learning.json
# Fixed value keeps sessions valid across restarts. Unset means a new random secret each start.
SESSION_SECRET=
# Set only when serving through a tunnel/proxy (e.g. Cloudflare Tunnel). Adds exactly this one origin to
# the /api host and origin allowlists and turns on the secure session cookie. Leave empty for localhost only.
# Example: https://your-tunnel.trycloudflare.com
PUBLIC_ORIGIN=
